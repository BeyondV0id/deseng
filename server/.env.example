# ---------------------------------------------------------------------------
# Database (Supabase)
#
# DATABASE_URL  the transaction-mode pooler, port 6543. The app connects here
#               with `prepare: false`, which transaction pooling requires.
# DIRECT_URL    the session connection, port 5432. drizzle-kit migrations use
#               this one; the transaction pooler cannot run session-level DDL.
#
# Replace YOUR-PASSWORD in both. Never commit the filled-in .env.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.fdcoawbylztucluthzxe:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.fdcoawbylztucluthzxe:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Better Auth
#
# Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the origin the auth server answers on. In development
# that is the API server, not Vite, because the client calls it through the
# Vite proxy.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# The SPA origin allowed to make authenticated requests (CSRF trusted origin).
CLIENT_ORIGIN="http://localhost:5180"

# Where the API server listens.
PORT=3001

# ---------------------------------------------------------------------------
# Social providers (optional; each pair is enabled only when both are set)
# Authorised redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/github
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email (Resend)
#
# Without RESEND_API_KEY every message is printed to the server console, so
# password reset works locally with the link copied from the terminal.
# EMAIL_FROM must be a verified sender on the Resend account.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="desgnix <no-reply@desgnix.app>"
